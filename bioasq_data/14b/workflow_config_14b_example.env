# Example workflow env for BioASQ 14b (derived from scripts/private_scripts/hpc/vega/config.env).
# Copy to a private path, set REPO_ROOT to your BioASQ clone, then replace every /path/to/... placeholder.
# Run: ./scripts/public/shared_scripts/run_retrieval_rerank_pipeline.sh --config /path/to/your_copy.env
#
# REPO_ROOT must be an absolute path to the repository root (same convention as private_scripts configs).
REPO_ROOT=/path/to/BioASQ

# ---------- Ground truth (eval metrics) ----------
HAVE_GROUND_TRUTH=1

# ---------- routes ----------
RUN_BASELINE=1          # build baseline evidence/generation (default: 1)
RUN_SNIPPET_RRF=1       # run snippet-rrf route (steps 6–7, evidence_snippet/, generation_snippet/)

# ---------- Shared ----------
WORKFLOW_OUTPUT_DIR=/path/to/workflow_output/14b_run
INPUT_JSONL=$REPO_ROOT/bioasq_data/14b/BioASQ-task14bPhaseA-testset3.jsonl
# INPUT_BATCH_JSONLS="$REPO_ROOT/bioasq_data/14b/other_split.jsonl"



# ---------- Index paths ----------
BM25_INDEX_PATH=/path/to/pubmed_bm25_index
# Single dense index directory:
DENSE_INDEX_DIR=/path/to/pubmed_dense_index
# Or sharded dense indices (if set, overrides DENSE_INDEX_DIR in the pipeline):
# DENSE_INDEX_GLOB=/path/to/pubmed_medembed_shard0*
# If you set DENSE_INDEX_GLOB, comment out DENSE_INDEX_DIR (glob wins in the pipeline).

# ---------- Retrieval ----------

TOP_K=2000
RECALL_KS=50,100,200,300,400,500,1000,2000

# ---------- Reranker ----------
# Corpus JSONL for candidate text and evidence lookup (glob allowed if your tooling expands it).
DOCS_JSONL=/path/to/pubmed_corpus/jsonl_shards/*.jsonl
RERANK_CANDIDATE_LIMIT=200
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_MODEL_DEVICE=cuda
RERANK_MODEL_BATCH=16
RERANK_MODEL_MAX_LENGTH=512

# Stage A (hybrid filter for windows)
SNIPPET_DENSE_MODEL=BAAI/bge-m3
SNIPPET_DENSE_DEVICE=cuda

# Stage B (CE rerank; optional multi-GPU)
SNIPPET_CE_MODEL=ncbi/MedCPT-Cross-Encoder
# SNIPPET_CE_DEVICE=cuda
SNIPPET_CE_BATCH=16

# ---------- Evidence (post_rerank JSONL + evidence/*_contexts.jsonl) ----------
POST_RERANK_DOC_POOL=30
EVIDENCE_TOP_K_SNIPPET=10

# ---------- Generation ----------
GENERATION_SCHEMAS_DIR=$REPO_ROOT/scripts/public/prompts/schemas
GENERATION_SLEEP=0.5
RUN_GENERATION_BASELINE=1
RUN_GENERATION_SNIPPET=1
