# dictycite-max — snippet route with the 2.5B LLM reranker in place of the cross-encoder.
# bge-reranker-v2-gemma scored highest at every cutoff in the working note's reranker comparison;
# it needs far more VRAM and time than the ~5 GB cross-encoder default.
#
# Copy to a private path, set REPO_ROOT, replace every /path/to/... placeholder, then:
#   ./scripts/public/shared_scripts/run_retrieval_rerank_pipeline.sh --config /path/to/your_copy.env
# The four batches differ only in INPUT_JSONL. Knob reference:
# https://github.com/fulaibaowang/RAG-scripts/blob/main/docs/PARAMETERS.md

REPO_ROOT=/path/to/BioASQ
HAVE_GROUND_TRUTH=0     # official Phase A test sets carry no gold documents

WORKFLOW_OUTPUT_DIR=/path/to/workflow_output/14b_batch4_max
INPUT_JSONL=$REPO_ROOT/bioasq_data/14b/BioASQ-task14bPhaseA-testset4.jsonl

# ---------- Index paths ----------
BM25_INDEX_PATH=/path/to/pubmed_bm25_index
DENSE_INDEX_GLOB=/path/to/pubmed_medembed_shard0*
DOCS_JSONL=/path/to/pubmed_corpus/jsonl_shards/*.jsonl

# ---------- Retrieval ----------
TOP_K=5000
RECALL_KS=50,100,200,300,400,500,1000,2000,5000
BM25_THREADS=8
BM25_SAVE_RUNS=1
BM25_SAVE_PER_QUERY=1
HYBRID_MODE=default
HYBRID_JOBS=8
RERANK_CANDIDATE_LIMIT=2000

RUN_DOCUMENT=0
RUN_SNIPPET_RRF=1

# ---------- Reranker (LLM) ----------
RERANK_MODEL=BAAI/bge-reranker-v2-gemma
RERANK_RERANKER_TYPE=llm
RERANK_MODEL_DEVICE=cuda
RERANK_MODEL_BATCH=16
RERANK_MODEL_MAX_LENGTH=512

# ---------- Snippet stage ----------
# Batches 3-4 reranked windows with MedCPT as below; batches 1-2 used the gemma reranker here too.
SNIPPET_DENSE_MODEL=BAAI/bge-m3
SNIPPET_DENSE_DEVICE=cuda
SNIPPET_N_DOCS=200
SNIPPET_WINDOW_SIZE=3
SNIPPET_TOP_W=12
SNIPPET_CE_MODEL=ncbi/MedCPT-Cross-Encoder
SNIPPET_CE_BATCH=16

# ---------- Generation (Phase B) ----------
GENERATION_SCHEMAS_DIR=$REPO_ROOT/scripts/public/prompts/schemas
GENERATION_SLEEP=0.5
RUN_GENERATION_SNIPPET=1
