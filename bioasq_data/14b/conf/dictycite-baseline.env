# dictycite-baseline — document route: one context per PubMed abstract.
# Hybrid retrieval, cross-encoder rerank, post-rerank fusion. This is the system the working
# note describes, and the one to start from.
#
# Copy to a private path, set REPO_ROOT, replace every /path/to/... placeholder, then:
#   ./scripts/public/shared_scripts/run_retrieval_rerank_pipeline.sh --config /path/to/your_copy.env
# The four batches differ only in INPUT_JSONL. Knob reference:
# https://github.com/fulaibaowang/RAG-scripts/blob/main/docs/PARAMETERS.md

REPO_ROOT=/path/to/BioASQ
HAVE_GROUND_TRUTH=0     # official Phase A test sets carry no gold documents

WORKFLOW_OUTPUT_DIR=/path/to/workflow_output/14b_batch4
INPUT_JSONL=$REPO_ROOT/bioasq_data/14b/BioASQ-task14bPhaseA-testset4.jsonl

# ---------- Index paths ----------
BM25_INDEX_PATH=/path/to/pubmed_bm25_index
DENSE_INDEX_GLOB=/path/to/pubmed_medembed_shard0*
DOCS_JSONL=/path/to/pubmed_corpus/jsonl_shards/*.jsonl

# ---------- Retrieval ----------
TOP_K=5000
RECALL_KS=50,100,200,300,400,500,1000,2000,5000
BM25_THREADS=8
BM25_SAVE_RUNS=1
BM25_SAVE_PER_QUERY=1
HYBRID_MODE=default
HYBRID_JOBS=8
RERANK_CANDIDATE_LIMIT=2000

RUN_DOCUMENT=1
RUN_SNIPPET_RRF=0

# ---------- Reranker ----------
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_RERANKER_TYPE=cross_encoder
RERANK_MODEL_DEVICE=cuda
RERANK_MODEL_BATCH=64
RERANK_MODEL_MAX_LENGTH=512

# ---------- Generation (Phase B) ----------
# Defaults to ollama at 127.0.0.1:11434 with llama3.3:latest.
GENERATION_SCHEMAS_DIR=$REPO_ROOT/scripts/public/prompts/schemas
GENERATION_SLEEP=0.5
RUN_GENERATION_DOCUMENT=1
