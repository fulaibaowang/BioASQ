# Settings behind the BioASQ 14b Phase A submissions (document + snippet routes).
#
# This is the configuration described in the working note: hybrid retrieval, cross-encoder
# rerank, post-rerank fusion, and the snippet route. It is the one we recommend reproducing.
# For a gentler first run see workflow_config_14b_example.env; for what every knob does see
# https://github.com/fulaibaowang/RAG-scripts/blob/main/docs/PARAMETERS.md
#
# Copy to a private path, set REPO_ROOT and replace every /path/to/... placeholder, then:
#   ./scripts/public/shared_scripts/run_retrieval_rerank_pipeline.sh --config /path/to/your_copy.env
#
# The batches differed only in INPUT_JSONL. Batch 1 additionally ran the t* score cutoff
# (RERANK_TSTAR_ENABLE=1, RERANK_TSTAR=0.4, RERANK_TSTAR_FLOOR=10) and built 30 contexts per
# question instead of 10; batches 2-4 used the settings exactly as written here.

REPO_ROOT=/path/to/BioASQ

# ---------- Ground truth ----------
# Official Phase A test sets carry no gold documents, so metrics would be all zero.
HAVE_GROUND_TRUTH=0

# ---------- Routes ----------
RUN_DOCUMENT=1          # document route: one context per PubMed abstract
RUN_SNIPPET_RRF=1       # snippet route: snippet windows + snippet/document fusion

# ---------- Shared ----------
WORKFLOW_OUTPUT_DIR=/path/to/workflow_output/14b_batch4
INPUT_JSONL=$REPO_ROOT/bioasq_data/14b/BioASQ-task14bPhaseA-testset4.jsonl

# ---------- Index paths ----------
BM25_INDEX_PATH=/path/to/pubmed_bm25_index
DENSE_INDEX_GLOB=/path/to/pubmed_medembed_shard0*
# Single (unsharded) dense index instead: DENSE_INDEX_DIR=/path/to/pubmed_dense_index

# ---------- Retrieval ----------
TOP_K=5000
RECALL_KS=50,100,200,300,400,500,1000,2000,5000
BM25_THREADS=8
BM25_SAVE_RUNS=1
BM25_SAVE_PER_QUERY=1
HYBRID_MODE=default
HYBRID_JOBS=8

# ---------- Reranker ----------
DOCS_JSONL=/path/to/pubmed_corpus/jsonl_shards/*.jsonl
RERANK_CANDIDATE_LIMIT=2000
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_MODEL_DEVICE=cuda
RERANK_MODEL_BATCH=64
RERANK_MODEL_MAX_LENGTH=512

# ---------- Snippet route ----------
# Stage A: hybrid filter over windows of SNIPPET_WINDOW_SIZE sentences
SNIPPET_DENSE_MODEL=BAAI/bge-m3
SNIPPET_DENSE_DEVICE=cuda
SNIPPET_N_DOCS=200
SNIPPET_WINDOW_SIZE=3
SNIPPET_TOP_W=12
# Stage B: cross-encoder rerank of the surviving windows
SNIPPET_CE_MODEL=ncbi/MedCPT-Cross-Encoder
SNIPPET_CE_BATCH=64

# ---------- Evidence ----------
# Contexts per question; 10 is the default and the BioASQ Phase A submission limit.
# EVIDENCE_TOP_K_DOCUMENT=10
# EVIDENCE_TOP_K_SNIPPET=10

# ---------- Generation (Phase B) ----------
# Defaults to ollama at 127.0.0.1:11434 with llama3.3:latest. Set GENERATION_BACKEND=openai_compat
# plus GEN_API_BASE / GENERATION_MODEL to use a hosted OpenAI-compatible endpoint instead.
GENERATION_SCHEMAS_DIR=$REPO_ROOT/scripts/public/prompts/schemas
GENERATION_SLEEP=0.5
RUN_GENERATION_DOCUMENT=1
RUN_GENERATION_SNIPPET=1
