REPO_ROOT=/work

# ---------- Ground truth (eval metrics) ----------
HAVE_GROUND_TRUTH=0

# ---------- routes ----------
RUN_DOCUMENT=1          # build document-route evidence/generation (default: 1)
RUN_SNIPPET_RRF=1       # run snippet-rrf route (steps 6–7, evidence_snippet/, generation_snippet/)

# ---------- Shared ----------
WORKFLOW_OUTPUT_DIR=/home/wangy/bioasq14_output/batch_4
INPUT_JSONL=$REPO_ROOT/bioasq_data/14b/BioASQ-task14bPhaseA-testset4.jsonl

TOP_K=5000
RECALL_KS=50,100,200,300,400,500,1000,2000,5000

# ---------- Index paths ----------
BM25_INDEX_PATH=/pubmed/pubmed_bm25_2026_index_with_keywords
# Use sharded dense index built at /pubmed/pubmed_medembed_shard00-09
DENSE_INDEX_GLOB=/pubmed/pubmed_medembed_shard0*

# ---------- BM25 ----------
BM25_THREADS=8
BM25_SAVE_RUNS=1
BM25_SAVE_PER_QUERY=1

# ---------- Dense ----------
# DENSE_EF_CAP=5000
# DENSE_DEVICE=cuda
# DENSE_BATCH_SIZE=256

# ---------- Hybrid ----------
HYBRID_MODE=default
HYBRID_JOBS=8
RETRIEVAL_FUSION_K_RRF=150   # keep previous sbatch behavior (RAG-scripts default lowered to 60)

# ---------- Reranker ----------
# For now, reuse the subset corpus JSONL for contexts; adjust if you have a full concatenated corpus.
DOCS_JSONL=/pubmed/jsonl_2026/*.jsonl
RERANK_CANDIDATE_LIMIT=2000
RERANK_MODEL=BAAI/bge-reranker-v2-m3 
RERANK_MODEL_DEVICE=cuda
RERANK_MODEL_BATCH=64
RERANK_MODEL_MAX_LENGTH=512
# RERANK_USE_MULTI_GPU=1
# RERANK_NUM_GPUS=3
# RERANK_PROGRESS_EVERY=0

#RERANK_TSTAR_ENABLE=1
#RERANK_TSTAR=0.4
#RERANK_TSTAR_FLOOR=10

# Stage A (hybrid filter for windows)
SNIPPET_DENSE_MODEL=BAAI/bge-m3
SNIPPET_DENSE_DEVICE=cuda

# Input: top N docs from rerank/post_rerank_fusion per query
SNIPPET_N_DOCS=200

# Windows: size 3, stride 1, keep top W per doc after Stage A
# SNIPPET_WINDOW_SIZE=3
# SNIPPET_WINDOW_STRIDE=1
SNIPPET_TOP_W=12

# Stage B (CE rerank; optional multi-GPU)
SNIPPET_CE_MODEL=ncbi/MedCPT-Cross-Encoder
# SNIPPET_CE_DEVICE=cuda
SNIPPET_CE_BATCH=64

# ---------- Evidence (post_rerank JSONL + evidence/*_contexts.jsonl) ----------
# POST_RERANK_DOC_POOL: max doc_ids per query from fused TSV written into post_rerank_*.jsonl (run_retrieval_rerank_pipeline default 30).
# Snippet route: same script merges CE windows into doc_snippet_windows when snippet/snippet_rerank/windows/{split}.jsonl exists.
# EVIDENCE_TOP_K_SNIPPET: max docs per question when building snippet contexts (build_contexts_from_snippets --evidence-top-k).
# POST_RERANK_DOC_POOL=30
# EVIDENCE_TOP_K_SNIPPET=10

# ---------- Listwise Reranking (RankZephyr, separate container) ----------
# Runs after the main pipeline in a dedicated vLLM container (Dockerfile.listwise).
# Requires snippet/snippet_doc_fusion output (RUN_SNIPPET_RRF=1 or --snippet-rrf in the main pipeline).
RUN_LISTWISE=0                              # set to 1 to include listwise stage in orchestration

# ---------- Generation ----------
# BioASQ typed schema snippets (summary/yesno/factoid/list); shared_scripts keeps default.txt only.
GENERATION_SCHEMAS_DIR=$REPO_ROOT/scripts/public/prompts/schemas
# These can be tuned or left unset to use defaults in generate_answers.py.
# GENERATION_CONCURRENCY=1
# GENERATION_MAX_CONTEXTS=8
# GENERATION_MAX_CHARS_PER_CONTEXT=1300
GENERATION_SLEEP=0.5
RUN_GENERATION_DOCUMENT=1   # run generation for document route (default: 1)
RUN_GENERATION_SNIPPET=1    # run generation for snippet route (default: 1)


