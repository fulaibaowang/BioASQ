# BioASQ pipeline — CPU-only (no CUDA). Use with sbatch_pipeline_cpu.sh.
# Tune RERANK_MODEL_BATCH / SNIPPET_*_BATCH if you hit RAM pressure.

REPO_ROOT=/work

# ---------- Ground truth (eval metrics) ----------
HAVE_GROUND_TRUTH=1

# ---------- routes ----------
RUN_BASELINE=1
RUN_SNIPPET_RRF=1

# ---------- Shared ----------
# Use a separate directory from GPU runs.
WORKFLOW_OUTPUT_DIR=/home/wangy/bioasq14_output/batch_3_cpu
TRAIN_JSON=$REPO_ROOT/bioasq_data/14b/BioASQ-task14bPhaseB-testset3

TOP_K=5000
RECALL_KS=50,100,200,300,400,500,1000,2000,5000

# ---------- Index paths ----------
BM25_INDEX_PATH=/pubmed/pubmed_bm25_2026_index_with_keywords
DENSE_INDEX_GLOB=/pubmed/pubmed_medembed_shard0*

# ---------- BM25 ----------
# Keep <= SLURM cpus if other stages run in parallel; 8 is a solid default.
BM25_THREADS=8
BM25_SAVE_RUNS=1
BM25_SAVE_PER_QUERY=1

# ---------- Dense (query encoding on CPU) ----------
DENSE_DEVICE=cpu
# Larger batches help throughput until RAM blows up; tune per node.
DENSE_BATCH_SIZE=64

# ---------- Hybrid ----------
HYBRID_MODE=default
# ProcessPoolExecutor workers; each worker should not multiply threads too high.
# Rule of thumb: HYBRID_JOBS * OMP_NUM_THREADS ≲ SLURM_CPUS_PER_TASK (see sbatch script).
HYBRID_JOBS=8

# ---------- Reranker (cross-encoder on CPU) ----------
DOCS_JSONL=/pubmed/jsonl_2026/*.jsonl
RERANK_CANDIDATE_LIMIT=2000
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_MODEL_DEVICE=cpu
# Bigger batch = better CPU utilization until OOM; raise with more RAM / fewer cores contending.
RERANK_MODEL_BATCH=64
RERANK_MODEL_MAX_LENGTH=512
RERANK_PROGRESS_EVERY=0

# Stage A (dense filter for windows)
SNIPPET_DENSE_MODEL=BAAI/bge-m3
SNIPPET_DENSE_DEVICE=cpu

SNIPPET_N_DOCS=200
SNIPPET_TOP_W=12

# Stage B (cross-encoder)
SNIPPET_CE_MODEL=ncbi/MedCPT-Cross-Encoder
SNIPPET_CE_DEVICE=cpu
SNIPPET_CE_BATCH=64

# ---------- Evidence ----------
EVIDENCE_TOP_K_SNIPPET=10

# ---------- Listwise ----------
RUN_LISTWISE=0

# ---------- Generation ----------
GENERATION_SCHEMAS_DIR=$REPO_ROOT/scripts/public/prompts/schemas
GENERATION_SLEEP=0.5
RUN_GENERATION_BASELINE=0
RUN_GENERATION_SNIPPET=0
