REPO_ROOT=/work

# ---------- Ground truth (eval metrics) ----------
HAVE_GROUND_TRUTH=0

# ---------- routes ----------
RUN_BASELINE=0          # build baseline evidence/generation (default: 1)
RUN_SNIPPET_RRF=1       # run snippet-rrf route (steps 6–7, evidence_snippet/, generation_snippet/)

# ---------- Query fields (body | body_expansion_synonyms | body_expansion_long) ----------
# Retrieval: which question field to use for BM25 and Dense. Reranker: which field to use when scoring candidates.
BM25_QUERY_FIELD=body
DENSE_QUERY_FIELD=body,body_hyde
DENSE_QUERY_FUSION_WEIGHTS=0.4,0.6

# ---------- Shared ----------
WORKFLOW_OUTPUT_DIR=/yun/bioasq14_output/batch_1_gemma_b200_new_no_GT
TRAIN_JSON=$REPO_ROOT/example/hyde/ready/BioASQ-task14bPhaseB-testset1.json

TOP_K=10000
RECALL_KS=50,100,200,300,400,500,1000,2000,5000

# ---------- Index paths ----------
BM25_INDEX_PATH=/pubmed/pubmed_bm25_2026_index_with_keywords
# Use sharded dense index built at /pubmed/pubmed_medembed_shard00-09
DENSE_INDEX_GLOB=/pubmed/pubmed_medembed_shard0*

# ---------- BM25 ----------
BM25_THREADS=8
BM25_SAVE_RUNS=1
BM25_SAVE_PER_QUERY=1

# ---------- Dense ----------
DENSE_EF_CAP=10000
# DENSE_DEVICE=cuda
# DENSE_BATCH_SIZE=256

# ---------- Hybrid ----------
HYBRID_MODE=default
HYBRID_JOBS=8
HYBRID_W_BM25=0.4
HYBRID_W_DENSE=0.6

# ---------- Reranker ----------
# For now, reuse the subset corpus JSONL for contexts; adjust if you have a full concatenated corpus.
DOCS_JSONL=/pubmed/jsonl_2026/*.jsonl
RERANK_CANDIDATE_LIMIT=5000
RERANK_MODEL=BAAI/bge-reranker-v2-gemma
RERANK_RERANKER_TYPE=llm
RERANK_MODEL_DEVICE=cuda
RERANK_MODEL_BATCH=64
RERANK_MODEL_MAX_LENGTH=640
# RERANK_USE_MULTI_GPU=1
# RERANK_NUM_GPUS=2
# RERANK_PROGRESS_EVERY=0

# Stage A (hybrid filter for windows)
SNIPPET_DENSE_MODEL=BAAI/bge-m3
SNIPPET_DENSE_DEVICE=cuda

# Input: top N docs from rerank_hybrid per query
SNIPPET_N_DOCS=400

# Windows: size 3, stride 1, keep top W per doc after Stage A
SNIPPET_WINDOW_SIZE=3
# SNIPPET_WINDOW_STRIDE=1
SNIPPET_TOP_W=15

# Stage B (CE rerank; optional multi-GPU)
SNIPPET_CE_DEVICE=cuda
SNIPPET_CE_BATCH=64

RRF_POOL_TOP_RERANK=400      # top-K from reranker for fusion pool (must be <= RERANK_CANDIDATE_LIMIT)
RRF_POOL_TOP_HYBRID=400      # top-K from hybrid stage-1 for fusion pool (must be <= HYBRID_CAP)

# ---------- Listwise Reranking (RankZephyr, separate container) ----------
# Runs after the main pipeline in a dedicated vLLM container (Dockerfile.listwise).
# Requires snippet_rrf output (RUN_SNIPPET_RRF=1 or --snippet-rrf in the main pipeline).
RUN_LISTWISE=1                              # set to 1 to include listwise stage in orchestration
LISTWISE_RUN_SLIDING=1
LISTWISE_FUSE_SLIDING=1 
RUN_GENERATION_LISTWISE=1 

# ---------- Generation ----------
# These can be tuned or left unset to use defaults in generate_answers.py.
# GENERATION_CONCURRENCY=1
#GENERATION_MAX_CONTEXTS=8
# GENERATION_MAX_CHARS_PER_CONTEXT=1300
GENERATION_SLEEP=0.5
RUN_GENERATION_BASELINE=0   # run generation for baseline route (default: 1)
RUN_GENERATION_SNIPPET=0    # run generation for snippet route (default: 1)

