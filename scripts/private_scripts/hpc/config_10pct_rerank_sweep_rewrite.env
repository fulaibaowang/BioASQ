# Rerank sweep over query rewrite fields (body_rewrite_A, body_rewrite_B).
# Uses existing hybrid runs from 10pct workflow; train/test from example/query_rewrite (files in generation).
# Source this and run sbatch_rerank_sweep_rewrite.sh — only the rerank stage runs, no retrieval.

REPO_ROOT=/work

# ---------- Hybrid runs (from full 10pct pipeline; do not re-run retrieval) ----------
WORKFLOW_OUTPUT_DIR=/yun/output/workflow_local_10pct_hpc_bge
RUNS_DIR=$WORKFLOW_OUTPUT_DIR/retrieval/fusion/runs
RUN_GLOB="best_rrf_*_top*.tsv"

# ---------- Train/test: rewrite JSONs (must have body_rewrite_A and body_rewrite_B) ----------
TRAIN_JSON=$REPO_ROOT/example/query_rewrite/training14b_10pct_sample_rewrite.json
TEST_BATCH_JSONS="$REPO_ROOT/example/query_rewrite/13B1_golden_rewrite.json $REPO_ROOT/example/query_rewrite/13B2_golden_rewrite.json $REPO_ROOT/example/query_rewrite/13B3_golden_rewrite.json $REPO_ROOT/example/query_rewrite/13B4_golden_rewrite.json"

# ---------- Reranker inputs ----------
DOCS_JSONL=/yun/output/subset_pubmed.jsonl
RERANK_CANDIDATE_LIMIT=1000
RERANK_KS_RECALL=50,100,200,300,400,500,1000,2000,5000

# ---------- Reranker model ----------
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_MODEL_DEVICE=cuda
RERANK_MODEL_BATCH=56
RERANK_MODEL_MAX_LENGTH=512
RERANK_USE_MULTI_GPU=1
RERANK_NUM_GPUS=3

# ---------- Sweep output base (each --query-field gets a subdir: rerank_body_rewrite_A, rerank_body_rewrite_B) ----------
RERANK_SWEEP_OUTPUT_DIR=/yun/output/rerank_sweep_query_rewrite
