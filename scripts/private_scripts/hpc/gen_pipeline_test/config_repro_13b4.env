# =====================================================================
# Reproducibility config — mimic the "old env" with the NEW subtree.
# Goal: rerun 13B4_golden end-to-end with GENERATION_MODE unset (=direct,
# byte-identical to the pre-distillation pipeline) and confirm retrieval +
# answer metrics match docs/RESULTS.md (split: 13B4_golden).
#
# Anchor numbers to match (docs/RESULTS.md):
#   Retrieval  Rerank_hybrid_200 MAP@10 = 0.3465 ; Snippet_rrf MAP@10 = 0.3454
#   Phase B document route: YN_Acc 0.8462, L_F1 0.3180, R_SU4_F1 0.1201
#
# Cloned from scripts/private_scripts/hpc/bioasq_runs/config.env; only the
# input split, ground-truth flag, and generation switches changed.
# =====================================================================
REPO_ROOT=/work

# ---------- Ground truth (eval metrics) ----------
HAVE_GROUND_TRUTH=1                 # 13B4_golden carries gold docs/snippets -> real MAP@10

# ---------- routes ----------
RUN_DOCUMENT=1
RUN_SNIPPET_RRF=1

# ---------- Shared ----------
# Both respect pre-set env (the sbatch drives per-cell output dirs); the values
# here are the standalone defaults.
WORKFLOW_OUTPUT_DIR="${WORKFLOW_OUTPUT_DIR:-/yun/bioasq14_output/repro_13b4_direct}"
# 13B4_golden.json must be converted to queries jsonl first (see sbatch).
INPUT_JSONL="${INPUT_JSONL:-$REPO_ROOT/bioasq_data/Task13BGoldenEnriched/13B4_golden.jsonl}"

TOP_K=5000
RECALL_KS=50,100,200,300,400,500,1000,2000,5000

# ---------- Index paths (full PubMed on the cluster) ----------
BM25_INDEX_PATH=/pubmed/pubmed_bm25_2026_index_with_keywords
DENSE_INDEX_GLOB=/pubmed/pubmed_medembed_shard0*

# ---------- BM25 ----------
BM25_THREADS=8
BM25_SAVE_RUNS=1
BM25_SAVE_PER_QUERY=1

# ---------- Hybrid ----------
HYBRID_MODE=default
HYBRID_JOBS=8

# ---------- Reranker (matches RESULTS.md: bge-reranker-v2-m3, len 512) ----------
DOCS_JSONL=/pubmed/jsonl_2026/*.jsonl
RERANK_CANDIDATE_LIMIT=2000
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_MODEL_DEVICE=cuda
RERANK_MODEL_BATCH=64
RERANK_MODEL_MAX_LENGTH=512
RERANK_PROGRESS_EVERY=0

# Snippet route (Stage A hybrid + Stage B CE)
SNIPPET_DENSE_MODEL=BAAI/bge-m3
SNIPPET_DENSE_DEVICE=cuda
SNIPPET_N_DOCS=200
SNIPPET_TOP_W=12
SNIPPET_CE_MODEL=ncbi/MedCPT-Cross-Encoder
SNIPPET_CE_BATCH=64

# ---------- Listwise (off) ----------
RUN_LISTWISE=0

# ---------- Generation (DIRECT = old behaviour) ----------
GENERATION_SCHEMAS_DIR=$REPO_ROOT/scripts/public/prompts/schemas
# GENERATION_MODE left unset => "direct" => byte-identical to old pipeline.
GENERATION_BACKEND=ollama
# GENERATION_MODEL=llama3.3:latest   # default; set to gemma variant to match a gemma anchor
GENERATION_SLEEP=0.5
RUN_GENERATION_DOCUMENT=1
RUN_GENERATION_SNIPPET=1
