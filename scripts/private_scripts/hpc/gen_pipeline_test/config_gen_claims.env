# =====================================================================
# Generation A/B/C test — mode=claims. Sources the repro base so retrieval/
# rerank/evidence settings are identical; only GENERATION_MODE (+ output dir,
# generator) differ. Seed the output dir with the repro run's retrieval/rerank/
# evidence (see sbatch) so only distill+generation run.
# WORKFLOW_OUTPUT_DIR and GENERATION_MODEL are env-driven (sbatch sets them per
# cell of the mode x generator matrix); values here are standalone defaults.
# Evaluate on the 60 oracle-rich list questions (oracle_rich_list_qids.txt).
# =====================================================================
# Capture any caller-set output dir BEFORE the base fills its own default.
_USER_OUT="${WORKFLOW_OUTPUT_DIR:-}"
_SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$_SELF_DIR/config_repro_13b4.env"

WORKFLOW_OUTPUT_DIR="${_USER_OUT:-/yun/bioasq14_output/gen_13b4_claims}"
GENERATION_MODE=claims
GENERATION_EXTRACT_MODEL="${GENERATION_EXTRACT_MODEL:-llama3.3:latest}"  # extractor/summarizer, independent of generator
