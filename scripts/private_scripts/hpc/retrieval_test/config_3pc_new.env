REPO_ROOT=/work

DENSE_QUERY_FIELD=body,body_hyde
DENSE_QUERY_FUSION_WEIGHTS=0.4,0.6

# ---------- Shared ----------
WORKFLOW_OUTPUT_DIR=/yun/output/retrieval_test/bm25_new
TRAIN_JSON=example/hyde/ready/training14b_3pct_sample.json
TEST_BATCH_JSONS="example/hyde/ready/13b_golden_50q_sample.json"

TOP_K=5000
RECALL_KS=50,100,200,300,400,500,1000,2000,5000

# ---------- Index paths (local) ----------
BM25_INDEX_PATH=/yun/indexes/pubmed_bm25_2026_subset_index_with_keywords
DENSE_INDEX_DIR=/pubmed/subset/pubmed_medembed_2026_subset_index

# ---------- BM25 ----------
# BM25_JAVA_MEM=8g
BM25_THREADS=4
# BM25_RM3_FEEDBACK_POOL=50
# BM25_RM3_FB_DOCS=20
# BM25_RM3_FB_TERMS=30
# BM25_RM3_LAMBDA=0.6
# BM25_INCLUDE_BASELINE=1
BM25_SAVE_RUNS=1
BM25_SAVE_PER_QUERY=1
# BM25_SAVE_ZERO_RECALL=1

# ---------- Dense ----------
DENSE_EF_CAP=5000
# DENSE_DEVICE=cpu
# DENSE_BATCH_SIZE=256

# ---------- Hybrid ----------
HYBRID_MODE=default
HYBRID_JOBS=4
# HYBRID_K_RRF=150
HYBRID_W_BM25=0.4
HYBRID_W_DENSE=0.6

# ---------- Reranker ----------
# For now, reuse the subset corpus JSONL for contexts; adjust if you have a full concatenated corpus.
DOCS_JSONL=/yun/output/subset_pubmed.jsonl
RERANK_CANDIDATE_LIMIT=2000
RERANK_MODEL=BAAI/bge-reranker-v2-m3 
RERANK_MODEL_DEVICE=cuda
RERANK_MODEL_BATCH=64
RERANK_MODEL_MAX_LENGTH=512
# RERANK_USE_MULTI_GPU=1
# RERANK_NUM_GPUS=3
RERANK_PROGRESS_EVERY=0

# ---------- Generation ----------
# These can be tuned or left unset to use defaults in generate_answers.py.
# GENERATION_CONCURRENCY=1
# GENERATION_MAX_CONTEXTS=8
# GENERATION_MAX_CHARS_PER_CONTEXT=1300
GENERATION_SLEEP=0.5
RUN_GENERATION_BASELINE=0   # run generation for baseline route (default: 1)