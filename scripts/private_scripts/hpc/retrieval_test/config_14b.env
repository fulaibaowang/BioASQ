REPO_ROOT=/work

# ---------- Ground truth (eval metrics) ----------
HAVE_GROUND_TRUTH=1

DENSE_QUERY_FIELD=body_hyde

# ---------- Shared ----------
WORKFLOW_OUTPUT_DIR=/yun/output/retrieval_test/hyde/
TRAIN_JSON=example/hyde/ready/BioASQ-task14bPhaseB-testset1.json

TOP_K=5000
RECALL_KS=50,100,200,300,400,500,1000,2000,5000

# ---------- Index paths ----------
BM25_INDEX_PATH=/pubmed/pubmed_bm25_2026_index
# Use sharded dense index built at /pubmed/pubmed_medembed_shard00-09
DENSE_INDEX_GLOB=/pubmed/pubmed_medembed_shard0*

# ---------- BM25 ----------
BM25_THREADS=8
BM25_SAVE_RUNS=1
BM25_SAVE_PER_QUERY=1

# ---------- Dense ----------
# DENSE_EF_CAP=5000
# DENSE_DEVICE=cuda
# DENSE_BATCH_SIZE=256

# ---------- Hybrid ----------
HYBRID_MODE=default
HYBRID_JOBS=8

# ---------- Reranker ----------
RUN_RERANK=0