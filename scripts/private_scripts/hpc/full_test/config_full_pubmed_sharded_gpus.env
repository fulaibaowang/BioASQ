REPO_ROOT=/work

# ---------- Ground truth (eval metrics) ----------
# HAVE_GROUND_TRUTH=1   # set to 0 to skip all eval metrics (BM25, Dense, Hybrid, Rerank)

# ---------- routes ----------
RUN_BASELINE=1          # build baseline evidence/generation (default: 1)
RUN_SNIPPET_RRF=1       # run snippet-rrf route (steps 6–7, evidence_snippet/, generation_snippet/)

# ---------- Shared ----------
WORKFLOW_OUTPUT_DIR=/yun/output/workflow_baseline_full_run_both_routes_gemma
INPUT_JSONL=$REPO_ROOT/example/training14b_10pct_sample.jsonl

INPUT_BATCH_JSONLS="$REPO_ROOT/bioasq_data/Task13BGoldenEnriched/13B1_golden.jsonl $REPO_ROOT/bioasq_data/Task13BGoldenEnriched/13B2_golden.jsonl $REPO_ROOT/bioasq_data/Task13BGoldenEnriched/13B3_golden.jsonl $REPO_ROOT/bioasq_data/Task13BGoldenEnriched/13B4_golden.jsonl"



TOP_K=5000
RECALL_KS=50,100,200,300,400,500,1000,2000,5000

# ---------- Index paths ----------
BM25_INDEX_PATH=/pubmed/pubmed_bm25_2026_index
# Use sharded dense index built at /pubmed/pubmed_medembed_shard00-09
DENSE_INDEX_GLOB=/pubmed/pubmed_medembed_shard0*

# ---------- BM25 ----------
BM25_THREADS=8
BM25_SAVE_RUNS=1
BM25_SAVE_PER_QUERY=1

# ---------- Dense ----------
# DENSE_EF_CAP=5000
# DENSE_DEVICE=cuda
# DENSE_BATCH_SIZE=256

# ---------- Hybrid ----------
HYBRID_MODE=default
HYBRID_JOBS=8

# ---------- Reranker ----------
# For now, reuse the subset corpus JSONL for contexts; adjust if you have a full concatenated corpus.
DOCS_JSONL=/pubmed/jsonl_2026/*.jsonl
RERANK_CANDIDATE_LIMIT=2000
RERANK_MODEL=BAAI/bge-reranker-v2-gemma
RERANK_RERANKER_TYPE=llm
RERANK_MODEL_DEVICE=cuda
RERANK_MODEL_BATCH=16
RERANK_MODEL_MAX_LENGTH=512
# RERANK_USE_MULTI_GPU=1
# RERANK_NUM_GPUS=3
# 0 = no per-query progress (quiet logs for Gemma/sbatch)
RERANK_PROGRESS_EVERY=0

# Stage A (hybrid filter for windows)
SNIPPET_DENSE_MODEL=BAAI/bge-m3
SNIPPET_DENSE_DEVICE=cuda

# Input: top N docs from rerank/post_rerank_fusion per query
SNIPPET_N_DOCS=200

# Windows: size 3, stride 1, keep top W per doc after Stage A
# SNIPPET_WINDOW_SIZE=4
# SNIPPET_WINDOW_STRIDE=1
SNIPPET_TOP_W=12

# Stage B (CE rerank; optional multi-GPU)
# SNIPPET_CE_MODEL=ncbi/MedCPT-Cross-Encoder
SNIPPET_CE_DEVICE=cuda
SNIPPET_CE_BATCH=16

RUN_LISTWISE=1

# ---------- Generation ----------
# These can be tuned or left unset to use defaults in generate_answers.py.
# GENERATION_CONCURRENCY=1
# GENERATION_MAX_CONTEXTS=10
# GENERATION_MAX_CHARS_PER_CONTEXT=1400
GENERATION_SLEEP=0.5
RUN_GENERATION_BASELINE=0   # run generation for baseline route (default: 1)
RUN_GENERATION_SNIPPET=0    # run generation for snippet route (default: 1)
