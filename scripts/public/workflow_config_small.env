# Small dataset (e.g. under 5k docs, quick run)
# Usage: source workflow_config_small.env && ./run_retrieval_rerank_pipeline.sh

WORKFLOW_OUTPUT_DIR=/path/to/output/small_run
TRAIN_JSON=/path/to/example/training14b_10pct_sample.json
TEST_BATCH_JSONS="/path/to/bioasq/13B1_golden.json"
TOP_K=1000
RECALL_KS=50,100,200,300,400,500
BM25_INDEX_PATH=/path/to/terrier_index_small
DENSE_INDEX_DIR=/path/to/dense_index_small
DOCS_JSONL=/path/to/subset_pubmed.jsonl
# RERANK_USE_MULTI_GPU=1   # set to 1 to use multiple GPUs
# RERANK_NUM_GPUS=0       # 0 = use all available GPUs
